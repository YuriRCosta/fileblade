{
  "schemaVersion": 1,
  "id": "data-goblin.blade-example",
  "name": "Blade Example",
  "version": "0.1.0",
  "author": "Kurt",
  "license": "MIT",
  "description": "Shows how a dependent Omarchy plugin contributes a module to FileBlade.",
  "kinds": [
    "service"
  ],
  "entryPoints": {
    "service": "Service.qml"
  },
  "extensions": {
    "data-goblin.fileblade/blade": [
      {
        "id": "clock",
        "name": "Clock",
        "glyph": "",
        "description": "A live clock that remembers its format per slot",
        "entry": "blades/Clock.qml",
        "hostContract": 1,
        "singleton": false,
        "settings": {
          "defaults": {
            "format": "HH:mm:ss",
            "caption": "",
            "scale": 1
          },
          "schema": [
            {
              "key": "format",
              "type": "enum",
              "label": "Format",
              "options": [
                {
                  "value": "HH:mm:ss",
                  "label": "24 h"
                },
                {
                  "value": "hh:mm AP",
                  "label": "12 h"
                },
                {
                  "value": "dddd d MMMM",
                  "label": "Date"
                },
                {
                  "value": "yyyy-MM-dd HH:mm",
                  "label": "ISO"
                }
              ]
            },
            {
              "key": "caption",
              "type": "string",
              "label": "Caption",
              "description": "Shown under the time; empty shows the hint",
              "maxLength": 48,
              "placeholder": "Space cycles the format"
            },
            {
              "key": "scale",
              "type": "number",
              "label": "Scale",
              "min": 0.6,
              "max": 2,
              "step": 0.1
            }
          ]
        }
      }
    ],
    "data-goblin.fileblade/action": [
      {
        "id": "dump",
        "title": "Dump FileBlade env",
        "glyph": "󰑶",
        "description": "Writes the action environment to last.json in the module state dir",
        "contexts": [
          "dir",
          "file",
          "selection",
          "root"
        ],
        "argv": [
          "scripts/dump-env"
        ],
        "paths": "env",
        "cwd": "plugin",
        "confirm": false,
        "timeout": 15,
        "detach": false,
        "output": "notice"
      }
    ]
  }
}
